  "compatibility_date": "2026-11-19",
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    { "pattern": "genesisidle.com", "custom_domain": true },
    { "pattern": "www.genesisidle.com", "custom_domain": true },
    { "pattern": "genesisidle.site", "custom_domain": true },
    { "pattern": "www.genesisidle.site", "custom_domain": true },
    { "pattern": "genesisidle.online", "custom_domain": true },
    { "pattern": "www.genesisidle.online", "custom_domain": true }
  ],
  "assets": {
    "directory": "./site",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
